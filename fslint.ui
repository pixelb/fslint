      <object class="GtkBox" id="dialog-vbox2">
        <property name="homogeneous">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <property name="visible">True</property>
        <child internal-child="action_area">
          <object class="GtkButtonBox" id="dialog-action_area2">
            <property name="layout-style">end</property>
            <property name="orientation">horizontal</property>
            <property name="visible">True</property>
            <child>
              <object class="GtkButton" id="cancel_path">
                <property name="can-default">True</property>
                <property name="can-focus">True</property>
                <property name="focus-on-click">True</property>
                <property name="label">gtk-cancel</property>
                <property name="relief">normal</property>
                <property name="use-stock">True</property>
                <property name="visible">True</property>
                <signal name="clicked" handler="quit"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ok_path">
                <property name="can-default">True</property>
                <property name="can-focus">True</property>
                <property name="focus-on-click">True</property>
                <property name="has-default">True</property>
                <property name="label">gtk-ok</property>
                <property name="relief">normal</property>
                <property name="use-stock">True</property>
                <property name="visible">True</property>
                <signal name="clicked" handler="on_ok_clicked"/>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="pack-type">GTK_PACK_END</property>
            <property name="padding">0</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkDialog" id="UserInteraction">
    <property name="decorated">True</property>
    <property name="default-height">100</property>
    <property name="default-width">150</property>
    <property name="destroy-with-parent">False</property>
    <property name="focus-on-map">True</property>
    <property name="gravity">north-west</property>
    <property name="modal">True</property>
    <property name="resizable">True</property>
    <property name="skip-pager-hint">False</property>
    <property name="skip-taskbar-hint">False</property>
    <property name="title" translatable="yes"/>
    <property name="type">toplevel</property>
    <property name="type-hint">dialog</property>
    <property name="urgency-hint">False</property>
    <property name="window-position">center-on-parent</property>
    <signal name="destroy" handler="quit"/>
    <child internal-child="vbox">
      <object class="GtkBox" id="dialog-vbox1">
        <property name="homogeneous">False</property>
