    if not gtk.init_check()[0]:
        sys.stderr.write("FSlint requires a graphical display.\n")
        return 1
    application = fslint(liblocation+"/fslint.ui", "fslint")
    gtk.main()
    return 0

if __name__ == "__main__":
    sys.exit(main())
