def human_num(num, divisor=1, power=""):
    num=float(num)
    if divisor == 1:
        return locale.format_string("%.f",num,1)
    elif divisor == 1000:
        powers=[" ","K","M","G","T","P"]
    elif divisor == 1024:
        powers=["  ","Ki","Mi","Gi","Ti","Pi"]
    else:
        raise ValueError("Invalid divisor")
    if not power: power=powers[0]
    while num >= 1000: #4 digits
        num /= divisor
        power=powers[powers.index(power)+1]
    if power.strip():
        num = locale.format_string("%6.1f",num,1)
    else:
        num = locale.format_string("%4.f",num,1)+'  '
    return "%s%s" % (num,power)

class pathInfo:
    """Gets path info appropriate for display, i.e.
        (ls_colour, du, size, uid, gid, ls_date, mtime)"""

    def __init__(self, path):
        stat_val = os.lstat(path)

        date = time.ctime(stat_val.st_mtime)
        month_time = date[4:16]
        year = date[-5:]
        timediff = time.time()-stat_val.st_mtime
        if timediff > 15552000: #6months
            date = month_time[0:6] + year
        else:
            date = month_time

        mode = stat_val.st_mode
        if stat.S_ISREG(mode):
            colour = '' #default
            if mode & (stat.S_IXGRP|stat.S_IXUSR|stat.S_IXOTH):
                colour = "#00C000"
        elif stat.S_ISDIR(mode):
            colour = "blue"
        elif stat.S_ISLNK(mode):
            colour = "cyan"
            if not os.path.exists(path):
                colour = "#C00000"
        else:
            colour = "tan"

        self.ls_colour = colour
        self.du = stat_val.st_blocks*512
        self.size = stat_val.st_size
        self.uid = stat_val.st_uid
        self.gid = stat_val.st_gid
        self.ls_date = date
        self.mtime = stat_val.st_mtime
        self.inode = stat_val.st_ino

class BuilderWrapper:
    """Load standard GtkBuilder widgets and connect this window's handlers."""
    def __init__(self, Filename, WindowName):
        self.widgets = gtk.Builder()
        self.widgets.set_translation_domain("fslint")
        import xml.etree.ElementTree as ET
        root = ET.parse(Filename).getroot()
        dependencies = [obj.get("id") for obj in root.findall("object")
                        if obj.get("class") not in
                        ("GtkWindow", "GtkDialog", "GtkFileChooserDialog")]
        self.widgets.add_objects_from_file(Filename, dependencies + [WindowName])
        self.GtkWindow = self.widgets.get_object(WindowName)
        self.tables = {}
        for widget in self.widgets.get_objects():
            if isinstance(widget, gtk.TreeView):
                self.tables[widget] = ResultList(widget)
        handlers = {}
        for attribute in dir(self.__class__):
            handler = getattr(self, attribute)
            if callable(handler):
                def wrap(widget, *args, handler=handler):
                    if isinstance(widget, gtk.TreeSelection):
                        widget = widget.get_tree_view()
                    return handler(self.tables.get(widget, widget), *args)
                handlers[attribute] = wrap
        self.widgets.connect_signals(handlers)

    def __getattr__(self, attribute):
        widget = self.widgets.get_object(attribute)
        if widget is None:
            raise AttributeError("Widget [" + attribute + "] not found")
        widget = self.tables.get(widget, widget)
        self.__dict__[attribute] = widget
        return widget

